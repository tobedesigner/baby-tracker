    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "exif-reader": "^2.0.3",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.5"
